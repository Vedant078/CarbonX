/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Coverage
/coverage

# Next.js build output
/.next/
/out/

# Production build
/build
/dist

# Logs & Debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment variables
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# Vercel deployment
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

