# CarbonX PostgreSQL Connection String
# For Render Deployment: Use Render PostgreSQL Internal Database URL
# Example: postgresql://carbonx_user:your_password@dpg-xxx-a.oregon-postgres.render.com/carbonx_db?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/carbonx

# Optional: Session Secret for signing tokens (defaults to generated crypto bytes)
SESSION_SECRET=your_secure_random_session_secret_here
